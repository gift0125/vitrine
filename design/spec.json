    "L2_frame_tint": {
      "what": "从画面取色给玻璃染色，伪造 vibrancy",
      "sample_region": "画面底部中间 60%×38%（控制栏背后那块）",
      "rule": "只取 HSL 的色相；饱和度固定 46%、明度固定 36% —— 不取明度",
      "why_no_luminance": "实测这张素材底部均值只有 rgb(46,62,71)，直接混进去等于把玻璃染得更黑；固定明度才能保证暗画面也有稳定色温",
      "mix_alpha": {
        "top": 0.26,
        "mid": 0.08,
        "bottom": "base .70"
      },
      "example": "rgb(46,62,71) → hsl(197,46%,36%) = rgb(50,103,123)",
      "impl_note": "切歌 / seek 后截一帧小图算一次并缓存，不要每帧算；mpv 用 screenshot-to-memory 缩到 48×30 足够",
      "cost": "低：一次缩略图 + 一次均值"
    },
    "L3_real_blur": {
      "what": "真正的区域级背景模糊（浏览器/ macOS 原生能力，Win 现在的叠加窗拿不到）",
